    "A chip a day. Green is what you ate.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 칸이 하루예요. 초록은 먹은 날이에요."
          }
        }
      }
    },
    "A heads-up before food goes bad?": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상하기 전에 미리 알려드릴까요?"
          }
        }
      }
    },
    "Account": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정"
          }
        }
      }
    },
    "Account and security information": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account and security information"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정과 보안 정보"
          }
        }
      }
    },
    "Account information and shared usage records are processed by Supabase in the Seoul region and kept until account deletion. Local data stays until you reset or erase it, or remove the app. Your phone's system backup settings may also retain app data.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 정보와 공유한 사용 기록은 Supabase 서울 리전에서 처리하고 계정 삭제 시까지 보관해요. 기기 데이터는 초기화하거나 지우거나 앱을 삭제할 때까지 보관해요. 휴대전화의 시스템 백업 설정에 따라 앱 데이터가 백업에 남을 수 있어요."
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가"
          }
        }
      }
