    },
    "%@, still to come": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, 아직 오지 않았어요"
          }
        }
      }
    },
    "%@. Open Reffi and fire a ticket.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Reffi를 열고 티켓을 발주하세요."
          }
        }
      }
    },
    "%@. Plan a dish before they turn.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. 상하기 전에 요리를 계획해보세요."
          }
        }
      }
    },
    "%@. Thaw and cook them today.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. 오늘 해동해서 요리하세요."
