      }
    },
    "Storage: %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관: %@"
          }
        }
      }
    },
    "Supabase service providers": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supabase service providers"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Supabase 처리업체 안내"
          }
        }
      }
    },
    "Supabase, Inc. provides account authentication and database hosting for Reffi, including storage of shared usage records. The project’s primary database is in Seoul, South Korea. Google LLC also processes messages sent to our Gmail contact address. These providers and their infrastructure and support providers may process information outside your country. The Seoul database location does not mean that all support, email delivery and security processing stays in South Korea. The other processing countries, recipients and contacts, transfer basis, and applicable retention periods are being verified before this policy takes effect.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supabase, Inc. provides account authentication and database hosting for Reffi, including storage of shared usage records. The project’s primary database is in Seoul, South Korea. Google LLC also processes messages sent to our Gmail contact address. These providers and their infrastructure and support providers may process information outside your country. The Seoul database location does not mean that all support, email delivery and security processing stays in South Korea. The other processing countries, recipients and contacts, transfer basis, and applicable retention periods are being verified before this policy takes effect."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Reffi는 Supabase, Inc.에 계정 인증과 데이터베이스 운영을 맡기며, 공유된 사용 기록도 이 서비스에 보관합니다. 프로젝트의 주 데이터베이스는 대한민국 서울에 있습니다. Google LLC는 Gmail 문의처로 보낸 메일을 처리합니다. 이들 서비스와 관련 인프라 및 지원 업체는 이용자의 거주 국가 밖에서 정보를 처리할 수 있습니다. 데이터베이스가 서울에 있다는 사실만으로 지원 업무, 이메일 발송, 보안 처리가 모두 한국에서 이루어진다고 단정할 수는 없습니다. 그 밖의 처리 국가, 수탁자와 연락처, 이전 근거 및 적용 보관기간은 이 방침의 시행 전에 확인하고 있습니다."
          }
        }
      }
    },
    "Switch to simple view": {
      "localizations": {
