{
  "sourceLanguage": "en",
  "strings": {
    "%@ won't last long. Find a video and cook it today.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, 오래 두기 어려워요. 영상을 찾아 오늘 요리해 보세요."
          }
        }
      }
    },
    "%@ · eaten": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · 먹었어요"
          }
        }
      }
    },
    "%@ · off the memo": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · 메모에서 뺐어요"
          }
        }
      }
    },
    "%@ · removed": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · 지웠어요"
          }
        }
      }
    },
    "%@ · tossed": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · 버렸어요"
          }
        }
      }
    },
    "%@, %lld eaten": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$lld개 먹음"
