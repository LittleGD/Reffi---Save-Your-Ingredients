{
  "sourceLanguage": "en",
  "strings": {
    "%1$@ (for %2$@)": {
      "comment": "Ticket line for substituted stock; 1st = stock name, 2nd = recipe line it stands in for",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@ 대신)"
          }
        }
      }
    },
    "%@ %lld": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$lld"
          }
        }
      }
    },
    "%@ eaten. Undo available.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 먹었어요. 되돌릴 수 있어요."
          }
        }
      }
    },
    "%@ off the memo. Undo available.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 메모에서 뺐어요. 되돌릴 수 있어요."
          }
        }
      }
    },
    "%@ recipe": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 레시피"
          }
        }
