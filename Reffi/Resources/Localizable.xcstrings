      }
    },
    "%@. Thaw and cook them today.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. 오늘 해동해서 요리하세요."
          }
        }
      }
    },
    "%@ %@": {
      "comment": "Quantity.text join — en은 NBSP로 숫자·단위를 묶고(§3.4), ko는 붙여 쓴다(3개).",
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@%@"
          }
        }
      }
    },
    "%lld days left": {
      "comment": "Spoken D-day label, e.g. 3 days left",
