{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reffi uses the camera to find grocery items on receipts for you to review and add."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영수증에서 추가할 재료를 찾을 때 카메라를 사용해요. 찾은 재료는 확인 후 담을 수 있어요."
          }
        }
      }
    },
    "NSMotionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reffi uses device motion to move the ingredients on screen as you tilt your phone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 기울임에 따라 재료가 움직이도록 모션 데이터를 사용해요."
          }
        }
      }
    }
  },
  "version": "1.0"
}
