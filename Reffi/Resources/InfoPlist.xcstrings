{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reffi uses the camera to scan grocery receipts so items are added automatically."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Reffi가 장보기 영수증을 스캔해 재료를 자동으로 추가할 수 있도록 카메라를 사용해요."
          }
        }
      }
    },
    "NSMotionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reffi tilts the ingredients on your counter with your device's motion."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 기울임에 따라 재료가 움직이도록 모션 데이터를 사용합니다."
          }
        }
      }
    }
  },
  "version": "1.0"
}
